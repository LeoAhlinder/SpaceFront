{
  "name": "spacefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "gen:trig": "tsx tools/gen-trig.ts && prettier --write src/core/math/trigTable.ts",
    "mapgen": "tsx tools/mapgen/earth.ts && tsx tools/mapgen/bodies.ts && prettier --write public/maps",
    "e2e": "playwright test",
    "atlas": "tsx tools/atlas/pack.ts && prettier --write src/client/render/atlasFrames.ts tools/atlas"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "pixi.js": "8.23.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "topojson-client": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2"
  }
}
